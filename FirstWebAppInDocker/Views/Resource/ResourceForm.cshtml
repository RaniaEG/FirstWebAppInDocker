@using FirstWebAppInDocker.Models.ViewModels.Resource
@model ResourceViewModel

@{
    ViewData["Title"] = "Resource Form";
}

<form asp-action="ResourceOverview" method="post">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SelectedTypes">Type</label>
        <select asp-for="SelectedTypes" class="form-control" multiple>
            @foreach (var type in Model.AvailableTypes)
            {
                if (Model.SelectedTypes != null && Model.SelectedTypes.Contains(type))
                {
                    <option value="@type" selected>@type</option>
                }
                else
                {
                    <option value="@type">@type</option>
                }
            }
        </select>
        <span asp-validation-for="SelectedTypes" class="text-danger"></span>
    </div>
     <label>Location</label>
    <div id="map" data-lat="@Model.Latitude" data-lng="@Model.Longitude" style="height: 400px;"></div>
    <input asp-for="Latitude" type="hidden" id="latitude" />
    <input asp-for="Longitude" type="hidden" id="longitude" />

    <button type="submit" class="btn btn-primary">Save</button>

</form>

@section Scripts {
    
    
    <script>
        // Read coordinates from data attributes and fall back to defaults
        var mapEl = document.getElementById('map');
        var initialLat = parseFloat(mapEl.dataset.lat);
        var initialLng = parseFloat(mapEl.dataset.lng);
        if (isNaN(initialLat)) initialLat = 58.163;
        if (isNaN(initialLng)) initialLng = 8.003;
        // Initialize the map
        var map = L.map('map').setView([initialLat, initialLng], 13);
        // Add a tile layer to the map
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        // Add a marker to the map
        // var marker = L.marker([58.163, 8.003]).addTo(map);

        // map.on('click', function(e) {
        //     var lat = e.latlng.lat;
        //     var lng = e.latlng.lng;
        //     marker.setLatLng([lat, lng]);
            
        //     document.getElementById('latitude').value = lat;
        //     document.getElementById('longitude').value = lng;

        //     L.marker([lat, lng]).addTo(map);
        // });

        // Initialize the feature group that will hold the drawn shapes
        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);
        
        // Creates the drawing control on the left-hand side of the map
        var drawControl = new L.Control.Draw({
            draw: {
                polygon: false,
                polyline: false,
                circle: false,
                rectangle: false,
                marker: true
            },
            edit: {
                featureGroup: drawnItems,
                remove: true
            }
        });
        map.addControl(drawControl);

        // Event handling when a layer is drawn on the map
        map.on('draw:created', function(e) {
            var layer = e.layer;
            drawnItems.addLayer(layer);

            // Get the coordinates of the drawn layer
            var latlng = layer.getLatLng();
            document.getElementById('latitude').value = latlng.lat;
            document.getElementById('longitude').value = latlng.lng;
        });
    </script>

    <!-- Client-side validation scripts -->
    <partial name="_ValidationScriptsPartial" /> 
}


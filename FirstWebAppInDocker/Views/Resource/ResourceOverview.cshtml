@using FirstWebAppInDocker.Models.ViewModels.Resource
@model ResourceViewModel

@{
    ViewData["Title"] = "Resource Overview";
}

<h2>Resource Overview</h2>
<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Type:</strong> @string.Join(", ", Model.SelectedTypes)</p>
<p><strong>Latitude:</strong> @Model.Latitude</p>
<p><strong>Longitude:</strong> @Model.Longitude</p>


<div id="map" data-lat="@Model.Latitude" data-lng="@Model.Longitude" style="height: 500px;"></div>

@section Scripts {
    
    <script>
        (function () {
            // Use invariant culture to ensure dots as decimal separators and fall back to default coordinates
            // Read coordinates from data attributes and fall back to defaults
            var mapEl = document.getElementById('map');
            var lat = parseFloat(mapEl.dataset.lat);
            var lng = parseFloat(mapEl.dataset.lng);
            if (isNaN(lat)) lat = 58.163;
            if (isNaN(lng)) lng = 8.003;

            // Initialize the map
            var map = L.map('map').setView([lat, lng], 13);

            // Add a tile layer to the map
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Initialize the feature group that will hold layers (consistent with ResourceForm)
            var drawnItems = new L.FeatureGroup();
            map.addLayer(drawnItems);

            // Create a marker at the model coordinates and add it to the feature group
            var marker = L.marker([lat, lng]);
            drawnItems.addLayer(marker);

            // Open popup after reverse geocode to ensure the address is displayed
            var url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;

            fetch(url)
                .then(function (response) {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(function (data) {
                    var address = data && data.display_name ? data.display_name : 'Address not found';
                    marker.bindPopup('<b>Address:</b> ' + address).openPopup();
                })
                .catch(function (err) {
                    console.error('Reverse geocode failed:', err);
                    marker.bindPopup('<b>Address:</b> Not available').openPopup();
                });
        })();
    </script>
}
